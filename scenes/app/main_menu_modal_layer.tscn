theme_override_colors/font_color = Color(0.28, 0.28, 0.22, 1)
theme_override_font_sizes/font_size = 17
text = "Sahabat Pangan Lokal merupakan permainan edukasi interaktif yang dirancang untuk memperkenalkan pangan lokal kepada siswa sekolah dasar melalui petualangan dan berbagai tantangan berbasis skenario."
autowrap_mode = 3

[node name="Paragraph2" type="Label" parent="AboutModal/OuterMargin/ModalVBox/AboutBodyScroll/AboutBody"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.28, 0.22, 1)
theme_override_font_sizes/font_size = 17
text = "Pemain diajak mengenali berbagai jenis pangan lokal, memilih pangan dalam kehidupan sehari-hari, berbelanja bahan pangan di pasar, menyelesaikan tantangan di dapur, hingga mengikuti Festival Pangan Lokal."
autowrap_mode = 3

[node name="Paragraph3" type="Label" parent="AboutModal/OuterMargin/ModalVBox/AboutBodyScroll/AboutBody"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.28, 0.22, 1)
theme_override_font_sizes/font_size = 17
text = "Permainan ini dikembangkan melalui kegiatan penelitian oleh tim dosen Universitas PGRI Silampari."
