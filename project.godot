; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sahabat Pangan Lokal"
run/main_scene="res://scenes/app/splash_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

ContentDatabase="*res://scripts/autoload/content_database.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
DeviceProfileManager="*res://scripts/autoload/device_profile_manager.gd"
AccountManager="*res://scripts/autoload/account_manager.gd"
ProgressManager="*res://scripts/autoload/progress_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
TelemetryManager="*res://scripts/autoload/telemetry_manager.gd"
AnalyticsLogger="*res://scripts/autoload/analytics_logger.gd"
DurationTracker="*res://scripts/autoload/duration_tracker.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
ResponsiveDisplay="*res://scripts/autoload/responsive_display.gd"
GlobalGameplayReturnModal="*res://scripts/autoload/global_gameplay_return_modal.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/aptos-narrow.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.945, 0.965, 0.945, 1)
